<section class="publications">
  <h2>{{site_title}}</h2>
  <p class="publication-count">Total publications: {{count}}</p>

  {{#entries_by_year}}
  <h3>{{year}}</h3>
  <ol class="publication-list">
    {{#entries}}
    <li id="{{id}}" class="publication-item publication-{{type}}">
      <span class="publication-authors">{{authors_display}}</span>.
      {{#pdf}}<a class="publication-title publication-title-link" href="{{pdf}}">"{{title}}"</a>.{{/pdf}}
      {{^pdf}}<span class="publication-title">"{{title}}"</span>.{{/pdf}}
      {{#venue}}<span class="publication-venue">{{venue}}</span>.{{/venue}}
      {{#year}}<span class="publication-year">{{year}}</span>.{{/year}}
      {{#url}}<a class="publication-link" href="{{url}}">link</a>{{/url}}
      {{#doi_url}} <a class="publication-doi" href="{{doi_url}}">doi</a>{{/doi_url}}
      {{#pdf}} <a class="publication-pdf" href="{{pdf}}">pdf</a>{{/pdf}}
      {{#supplementary}} <a class="publication-supplementary" href="{{supplementary}}">supplementary</a>{{/supplementary}}
      {{#code}} <a class="publication-code" href="{{code}}">code</a>{{/code}}
    </li>
    {{/entries}}
  </ol>
  {{/entries_by_year}}

  <p class="publication-generated">Generated on {{generated_on}}</p>
</section>
